{
  "name": "aLandi Cloud Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [8000, 4000],
  "portsAttributes": {
    "8000": {
      "label": "aLandi FastAPI gateway",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "4000": {
      "label": "aLandi local web preview",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m venv ~/.venvs/uv && ~/.venvs/uv/bin/pip install --disable-pip-version-check uv && ~/.venvs/uv/bin/uv sync --frozen --group dev"
}
