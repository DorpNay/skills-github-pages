# Generate a unique 64-character secret with: openssl rand -hex 32
# Never commit a real .env file or paste this key into source code.
ALANDI_API_KEY=replace-with-a-new-random-64-character-hex-secret
OLLAMA_BASE_URL=http://127.0.0.1:11434
ALANDI_ALLOWED_MODELS=qwen3.5:4b
ALANDI_CORS_ORIGINS=https://dorpnay.github.io
ALANDI_MAX_BODY_BYTES=8388608
ALANDI_UPSTREAM_TIMEOUT_SECONDS=300
ALANDI_MAX_INFLIGHT_REQUESTS=1
# Must match OLLAMA_CONTEXT_LENGTH configured on Ollama.
ALANDI_MODEL_CONTEXT_LENGTH_TOKENS=4096
# Exact completed-response cache: SQLite on the VPS; prompts are never logged.
ALANDI_CACHE_ENABLED=true
ALANDI_CACHE_PATH=/var/lib/alandi-gateway/response-cache.sqlite3
ALANDI_CACHE_TTL_SECONDS=900
ALANDI_CACHE_MAX_ENTRIES=1000
ALANDI_CACHE_MAX_RESPONSE_BYTES=1000000

# Experimental capabilities: off by default, enable only after running the gateway evals.
ALANDI_FAST_ROUTING_ENABLED=false
ALANDI_MEMORY_SYNC_ENABLED=false
ALANDI_MEMORY_PATH=/var/lib/alandi-gateway/memory.sqlite3
ALANDI_MEMORY_MAX_STATE_BYTES=512000
# Structured, provenance-backed memory graph API; off unless deliberately enabled.
ALANDI_MEMORY_GRAPH_ENABLED=false
ALANDI_MEMORY_GRAPH_PATH=/var/lib/alandi-gateway/memory-graph.sqlite3
# Global memory requires this server flag AND global_opt_in=true on every request.
ALANDI_GLOBAL_MEMORY_ENABLED=false
ALANDI_RAG_ENABLED=false
ALANDI_RAG_PATH=/var/lib/alandi-gateway/rag.sqlite3
ALANDI_RAG_MAX_CHUNK_CHARS=20000
# Optional fixed SearXNG instance; endpoint is authenticated and disabled until deployed/verified.
ALANDI_SEARXNG_ENABLED=false
ALANDI_SEARXNG_BASE_URL=
ALANDI_SEARXNG_MAX_RESULTS=5
# Optional local whisper.cpp transcription; all paths refer to binaries/model already on this host.
# Disabled by default. Never downloads models or sends audio to a remote API.
ALANDI_AUDIO_TRANSCRIPTION_ENABLED=false
ALANDI_AUDIO_TRANSCRIPTION_BINARY=/usr/local/bin/whisper-cli
ALANDI_AUDIO_TRANSCRIPTION_MODEL=/var/lib/alandi-models/ggml-small.bin
ALANDI_AUDIO_TRANSCRIPTION_FFPROBE_BINARY=/usr/bin/ffprobe
ALANDI_AUDIO_TRANSCRIPTION_FFMPEG_BINARY=/usr/bin/ffmpeg
ALANDI_AUDIO_TRANSCRIPTION_MAX_BYTES=15728640
ALANDI_AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=120
# Optional local Piper TTS; voice/model licensing must be reviewed separately.
ALANDI_AUDIO_SPEECH_ENABLED=false
ALANDI_AUDIO_SPEECH_BINARY=/opt/alandi/venv/bin/python
ALANDI_AUDIO_SPEECH_MODEL=en_US-lessac-medium
ALANDI_AUDIO_SPEECH_DATA_DIR=/var/lib/alandi-models/piper
ALANDI_AUDIO_SPEECH_TIMEOUT_SECONDS=60
# Inventory threshold only; not a system RAM or KV-cache limit.
ALANDI_MODEL_SIZE_ADVISORY_MB=6144

# Optional single-user Google OAuth Authorization Code + PKCE; disabled by default.
# The server-side OAuth routes are implemented, but Drive Picker/file import UI is not yet integrated.
# Enable only after registering the exact HTTPS callback in Google Cloud Console and testing it.
# Generate once in a secure environment; store outside Git with owner-only permissions:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
OAUTH_ENABLED=false
OAUTH_ENCRYPTION_KEY=
OAUTH_TOKEN_VAULT_PATH=/var/lib/alandi-gateway/oauth.sqlite3
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://YOUR_GATEWAY_HOST/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=https://dorpnay.github.io/skills-github-pages/
