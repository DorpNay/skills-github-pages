import { Page, Locator, expect } from '@playwright/test'

export class ChatPage {
  constructor(private page: Page) {}

  get composer() { return this.page.locator('#composer-input') }
  get sendBtn() { return this.page.locator('#send-btn') }
  get stopBtn() { return this.page.locator('#stop-btn') }
  get transcript() { return this.page.locator('.chat-transcript') }
  get messages() { return this.transcript.locator('article[data-message-id]') }
  get lastMessage() { return this.messages.last() }
  get streamingIndicator() { return this.page.locator('.streaming-indicator') }

  async sendMessage(text: string) {
    await this.composer.fill(text)
    await this.sendBtn.click()
    await expect(this.stopBtn).toBeVisible()
  }

  async waitForStreamingComplete(timeout = 30000) {
    await expect(this.stopBtn).toBeHidden({timeout})
  }

  async getLastMessageText() {
    return this.lastMessage.locator('.message-content').textContent()
  }

  async assertMessageCount(count: number) {
    await expect(this.messages).toHaveCount(count)
  }

  async assertStreamingRendered() {
    // Check that streaming-pending element exists during streaming
    await expect(this.page.locator('.streaming-pending')).toBeVisible()
    await this.waitForStreamingComplete()
    await expect(this.page.locator('.streaming-pending')).toBeHidden()
  }
}
