// tests/prompts/runner.ts
import { LLMRouter } from '../../router/LLMRouter'
import { evaluateQuality } from './quality-evaluator'

export async function runPromptTests() {
  const fixtures = await loadFixtures()
  const results = []
  
  for (const fixture of fixtures) {
    for (const variant of fixture.variants) {
      const prompt = loadPrompt(variant)
      const router = new LLMRouter({...loadConfig(), systemPrompt: prompt})
      
      const result = await router.complete({
        messages: [{role: 'user', content: fixture.input}],
        metadata: {task: 'code'}
      }, `test-${fixture.name}-${variant}`)
      
      const quality = await evaluateQuality(result.response, fixture.expected)
      results.push({fixture: fixture.name, variant, ...quality, passed: quality.score >= fixture.expected.minQualityScore})
    }
  }
  
  // Fail CI if any required fixture fails
  const failed = results.filter(r => !r.passed && r.required !== false)
  if (failed.length) {
    console.error('Prompt regression:', failed)
    process.exit(1)
  }
  console.log('All prompt tests passed')
}
