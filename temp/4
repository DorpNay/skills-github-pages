### 2. Incremental Streaming Markdown (Phase 1) — *Engineering Spec*

**Approach:** Adapt Incremark/Markstream algorithm — detect stable boundaries, cache completed blocks.

```typescript
// streaming/IncrementalMarkdown.ts
interface Block {
  type: 'paragraph' | 'heading' | 'code' | 'list' | 'blockquote' | 'table' | 'hr'
  startLine: number
  endLine: number      // -1 = still open
  content: string
  html: string         // rendered, never changes once closed
}

export class IncrementalMarkdown {
  private buffer = ''
  private lines: string[] = []
  private blocks: Block[] = []
  private pendingBlockIndex = -1
  
  // Streaming entry point
  append(chunk: string): {html: string, isComplete: boolean} {
    this.buffer += chunk
    this.updateLines()
    this.updateBlocks()
    return this.render()
  }

  private updateLines() {
    this.lines = this.buffer.split('\n')
  }

  private updateBlocks() {
    // Find stable boundary: last line that CLOSES a block
    // Heuristics: blank line after paragraph, ``` close, heading start, list item after blank
    let newPending = -1
    for (let i = this.blocks.length - 1; i >= 0; i--) {
      const b = this.blocks[i]
      if (b.endLine === -1) {
        // Check if this block is now closed
        if (this.isBlockClosed(b, i)) {
          b.endLine = this.findBlockEnd(b)
          b.html = this.renderBlock(b) // render ONCE
        } else {
          newPending = i
        }
      }
    }
    this.pendingBlockIndex = newPending
  }

  private isBlockClosed(block: Block, index: number): boolean {
    const start = block.startLine
    const lines = this.lines.slice(start)
    
    switch (block.type) {
      case 'paragraph':
        // Closed by blank line or new block start
        return lines.some((l, i) => i > 0 && (l.trim() === '' || this.isBlockStart(l)))
      case 'code':
        return lines.some((l, i) => i > 0 && l.trim().startsWith('```'))
      case 'heading':
        return true // headings are single-line
      case 'list':
        return lines.some((l, i) => i > 0 && l.trim() === '' && !this.isListContinuation(l))
      case 'blockquote':
        return lines.some((l, i) => i > 0 && !l.trim().startsWith('>'))
      default:
        return false
    }
  }

  private render(): {html: string, isComplete: boolean} {
    let html = ''
    for (const block of this.blocks) {
      if (block.endLine !== -1) {
        html += block.html // cached, stable
      } else {
        // Render pending block with streaming-friendly parser
        html += this.renderPendingBlock(block)
      }
    }
    return {html, isComplete: this.pendingBlockIndex === -1}
  }

  // DOMPurify sanitization happens ONCE per completed block
  // Pending block: sanitize with DOMPurify.SANITIZE_DOM on each append (small)
}
```

**Integration with existing Marked + DOMPurify:**
```typescript
// streaming/StreamingRenderer.ts
import { IncrementalMarkdown } from './IncrementalMarkdown'
import { marked } from 'marked'
import DOMPurify from 'dompurify'

export class StreamingRenderer {
  private parser = new IncrementalMarkdown()
  private container: HTMLElement
  private pendingElement: HTMLElement

  constructor(container: HTMLElement) {
    this.container = container
    this.pendingElement = document.createElement('div')
    this.pendingElement.className = 'streaming-pending'
    this.container.appendChild(this.pendingElement)
  }

  append(chunk: string) {
    const {html, isComplete} = this.parser.append(chunk)
    if (isComplete) {
      // All blocks stable — replace entire container with sanitized HTML
      this.container.innerHTML = DOMPurify.sanitize(html)
      this.pendingElement.remove()
    } else {
      // Only update pending tail
      this.pendingElement.innerHTML = DOMPurify.sanitize(html)
    }
  }

  reset() {
    this.parser = new IncrementalMarkdown()
    this.container.innerHTML = ''
    this.pendingElement = document.createElement('div')
    this.pendingElement.className = 'streaming-pending'
    this.container.appendChild(this.pendingElement)
  }
}
