    const last = entries[entries.length - 1] as PerformanceEntry & {element?: Element}
    report({name: 'LCP', value: last.startTime, rating: rateLCP(last.startTime), url: location.href})
  }).observe({type: 'largest-contentful-paint', buffered: true})

  // INP (via Event Timing)
  new PerformanceObserver((list) => {
    for (const entry of list.getEntries()) {
      if (entry.entryType === 'event' && entry.duration > 0) {
        report({name: 'INP', value: entry.duration, rating: rateINP(entry.duration), url: location.href})
      }
    }
  }).observe({type: 'event', durationThreshold: 16, buffered: true})

  // CLS
  let clsValue = 0
  new PerformanceObserver((list) => {
    for (const entry of list.getEntries()) {
      if (!entry.hadRecentInput) clsValue += (entry as any).value
    }
    report({name: 'CLS', value: clsValue, rating: rateCLS(clsValue), url: location.href})
  }).observe({type: 'layout-shift', buffered: true})
}

function report(metric: CWVMetric) {
  // Send via sendBeacon (non-blocking)
  navigator.sendBeacon('/api/metrics/cwv', JSON.stringify(metric))
  // Also log to console in dev
  if (import.meta.env.DEV) console.log('[CWV]', metric)
}

function rateLCP(v: number) { return v <= 2500 ? 'good' : v <= 4000 ? 'needs-improvement' : 'poor' }
function rateINP(v: number) { return v <= 200 ? 'good' : v <= 500 ? 'needs-improvement' : 'poor' }
function rateCLS(v: number) { return v <= 0.1 ? 'good' : v <= 0.25 ? 'needs-improvement' : 'poor' }
