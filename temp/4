**Flake Scoring (playwright-chat-lab pattern):**
```typescript
// tests/e2e/utils/flake-score.ts
import { test } from '@playwright/test'

const SEEDS = Array.from({length: 10}, (_, i) => i + 1)

export async function flakeScore(testName: string, fn: (seed: number) => Promise<void>) {
  const results = []
  for (const seed of SEEDS) {
    try {
      await fn(seed)
      results.push({seed, passed: true})
    } catch (e) {
      results.push({seed, passed: false, error: e.message})
    }
  }
  const passRate = results.filter(r => r.passed).length / results.length
  console.log(`[FlakeScore] ${testName}: ${Math.round(passRate * 100)}% (${results.filter(r => r.passed).length}/${SEEDS.length})`)
  if (passRate < 0.9) throw new Error(`Flake score ${passRate} below 90% threshold`)
}
```

