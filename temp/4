**Main Thread Integration:**
```typescript
// streaming/CodeBlockHighlighter.ts
class ShikiWorkerPool {
  private workers: Worker[] = []
  private queue: Array<{code: string, lang: string, resolve: Function, reject: Function}> = []
  private busy = 0
  private readonly MAX_WORKERS = navigator.hardwareConcurrency || 4

  async highlight(code: string, lang: string, theme: string): Promise<string> {
    return new Promise((resolve, reject) => {
      this.queue.push({code, lang, theme, resolve, reject})
      this.process()
    })
  }

  private process() {
    if (this.busy >= this.MAX_WORKERS || this.queue.length === 0) return
    this.busy++
    const task = this.queue.shift()!
    const worker = this.getWorker()
    
    const id = Math.random()
    worker.postMessage({...task, id})
    
    const handler = (e: MessageEvent) => {
      if (e.data.id !== id) return
      worker.removeEventListener('message', handler)
      this.busy--
      if (e.data.success) task.resolve(e.data.html)
      else task.reject(new Error(e.data.error))
      this.process()
    }
    worker.addEventListener('message', handler)
  }

  private getWorker(): Worker {
    if (this.workers.length < this.MAX_WORKERS) {
      const w = new Worker(new URL('./shiki-worker.ts', import.meta.url), {type: 'module'})
      this.workers.push(w)
      return w
    }
    return this.workers[this.busy % this.MAX_WORKERS]
  }
}

export const shikiPool = new ShikiWorkerPool()
