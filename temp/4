**Library:** `dexie@4` (TypeScript-first, 22KB gzipped)

```typescript
// db/schema.ts
import { Dexie } from 'dexie'

export interface Chat {
  id: string
  title: string
  messages: Message[]
  created: number
  updated: number
  provider?: string
  model?: string
}

export interface Message {
  role: 'user' | 'assistant' | 'system' | 'tool'
  content: string
  timestamp: number
  toolCalls?: ToolCall[]
  metadata?: { tokens?: number; latencyMs?: number; cached?: boolean }
}

export interface CacheEntry {
  id?: number
  promptHash: string      // SHA-256 of normalized prompt
  embedding: Float32Array // 1536-dim Float32Array
  response: string
  hits: number
  created: number
  updated: number
}

export interface SyncOp {
  id?: number
  type: 'chat' | 'message' | 'settings'
  payload: any
  retries: number
  created: number
}

export class AppDB extends Dexie {
  chats!: Dexie.Table<Chat, string>
  settings!: Dexie.Table<{key: string, value: any}, string>
  cache!: Dexie.Table<CacheEntry, number>
  syncQueue!: Dexie.Table<SyncOp, number>

  constructor() {
    super('ai-mobile-agent')
    this.version(1).stores({
      chats: 'id, updated, created',
      settings: 'key',
      cache: '++id, promptHash, updated',
      syncQueue: '++id, type, created'
    })
    // Custom hook: load embeddings to memory on open
    this.on('ready', () => this.loadEmbeddingsToMemory())
  }

  private embeddingMemory: Map<string, Float32Array> = new Map()
  
  async loadEmbeddingsToMemory() {
    const entries = await this.cache.toArray()
    for (const e of entries) this.embeddingMemory.set(e.promptHash, e.embedding)
  }

  async semanticSearch(queryEmbedding: Float32Array, threshold = 0.85, topK = 3) {
    let best: {entry: CacheEntry, score: number}[] = []
    for (const [hash, emb] of this.embeddingMemory) {
      const score = cosineSimilarity(queryEmbedding, emb)
      if (score >= threshold) best.push({entry: await this.cache.get({promptHash: hash})!, score})
    }
    return best.sort((a,b) => b.score - a.score).slice(0, topK)
  }
}

function cosineSimilarity(a: Float32Array, b: Float32Array): number {
  let dot = 0, magA = 0, magB = 0
  for (let i = 0; i < a.length; i++) {
    dot += a[i] * b[i]
    magA += a[i] * a[i]
    magB += b[i] * b[i]
  }
  return dot / (Math.sqrt(magA) * Math.sqrt(magB))
}

export const db = new AppDB()
```

