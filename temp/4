// Context-aware dispatcher
export function dispatchAction(id: string, currentContext: string) {
  const action = actions.find(a => a.id === id)
  if (!action || !action.contexts.includes(currentContext as any) && !action.contexts.includes('global')) return
  action.handler()
}

// Keyboard listener
export function setupGlobalHotkeys(getContext: () => string) {
  document.addEventListener('keydown', (e) => {
    const ctx = getContext()
    const chord = [
      e.ctrlKey || e.metaKey ? 'Ctrl' : null,
      e.shiftKey ? 'Shift' : null,
      e.altKey ? 'Alt' : null,
      e.key.length === 1 ? e.key.toUpperCase() : e.key
    ].filter(Boolean).join('+')
    
    const action = actions.find(a => a.shortcut === chord && (a.contexts.includes(ctx) || a.contexts.includes('global')))
    if (action) {
      e.preventDefault()
      action.handler()
    }
  })
}
