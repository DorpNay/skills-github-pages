export async function checkA11yStreaming() {
  // axe-core on streaming container during active stream
  const {axe} = await import('axe-core')
  const results = await axe.run(document.querySelector('.chat-transcript'))
  const streamingViolations = results.violations.filter(v => 
    v.tags.includes('wcag2aa') && v.nodes.some(n => n.target.includes('.streaming-pending'))
  )
  if (streamingViolations.length) throw new Error(`A11y violations in streaming: ${streamingViolations.map(v => v.id).join(', ')}`)
}

