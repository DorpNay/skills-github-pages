**Router Implementation** (TypeScript, ~150 lines):
```typescript
// router/LLMRouter.ts
interface RouteRule {
  name: string
  when: WhenPredicate
  use: ProviderConfig
  fallback?: ProviderConfig[]
}

interface ProviderConfig {
  provider: string
  model: string
  params?: Record<string, any>
}

interface Attempt {
  provider: string
  model: string
  latencyMs: number
  error?: Error
  success: boolean
}

export class LLMRouter {
  private config: RouterConfig
  private providerClients: Map<string, OpenAIClient>
  private sessionProvider = new Map<string, string>() // conversationId -> provider

  constructor(config: RouterConfig) {
    this.config = config
    this.providerClients = new Map()
    for (const [name, p] of Object.entries(config.providers)) {
      this.providerClients.set(name, new OpenAIClient({
        baseURL: p.baseUrl,
        apiKey: import.meta.env[p.keyEnv],
        timeout: config.timeoutMs
      }))
    }
  }

  async complete(request: ChatRequest, conversationId: string): Promise<RouterResult> {
    const route = this.selectRoute(request)
    const primary = route.use
    const chain = [primary, ...(route.fallback || [])]
    
    // Sticky session: prefer last successful provider for this conversation
    const sticky = this.sessionProvider.get(conversationId)
    if (sticky) {
      const idx = chain.findIndex(c => c.provider === sticky)
      if (idx > 0) [chain[0], chain[idx]] = [chain[idx], chain[0]]
    }

    const attempts: Attempt[] = []
    
    for (let i = 0; i < chain.length; i++) {
      const cfg = chain[i]
      const client = this.providerClients.get(cfg.provider)
      if (!client) continue

      const start = performance.now()
      try {
        const response = await client.chat.completions.create({
          model: cfg.model,
          messages: request.messages,
          stream: request.stream,
          ...cfg.params
        })
        
        const latencyMs = performance.now() - start
        attempts.push({provider: cfg.provider, model: cfg.model, latencyMs, success: true})
        
        // Update sticky session
        this.sessionProvider.set(conversationId, cfg.provider)
        
        return {response, attempts, provider: cfg.provider, model: cfg.model}
      } catch (error) {
        const latencyMs = performance.now() - start
        const isRetryable = this.config.retryableStatusCodes.includes(error?.status || 0)
        attempts.push({provider: cfg.provider, model: cfg.model, latencyMs, error, success: false})
        
        if (!isRetryable || i === chain.length - 1) {
          throw new AllProvidersFailedError(attempts)
        }
        // Exponential backoff before next attempt
        await sleep(1000 * Math.pow(2, i))
      }
    }
    throw new AllProvidersFailedError(attempts)
  }

  private selectRoute(request: ChatRequest): RouteRule {
    // Evaluate predicates in order; first match wins
    for (const rule of this.config.routes) {
      if (this.evalPredicate(rule.when, request)) return rule
    }
    return this.config.routes.find(r => r.name === this.config.defaultRoute)!
  }

  private evalPredicate(predicate: WhenPredicate, request: ChatRequest): boolean {
    if (predicate === true) return true
    if (predicate.task && request.metadata?.task !== predicate.task) return false
    if (predicate.min_tokens && request.max_tokens < predicate.min_tokens) return false
    if (predicate.max_tokens && request.max_tokens > predicate.max_tokens) return false
    if (predicate.model && !request.model?.includes(predicate.model)) return false
    return true
  }
}
```

