**Streaming Announcement Controller:**
```typescript
// a11y/StreamingAnnouncer.ts
export class StreamingAnnouncer {
  private announcer = document.getElementById('status-announcer')!
  private buffer = ''
  private lastAnnounced = ''
  private announceTimer: number | null = null

  // Called on each chunk
  append(chunk: string) {
    this.buffer += chunk
    this.scheduleAnnouncement()
  }

  private scheduleAnnouncement() {
    if (this.announceTimer) clearTimeout(this.announceTimer)
    this.announceTimer = window.setTimeout(() => this.announceIfNeeded(), 300)
  }

  private announceIfNeeded() {
    // Only announce at stable boundaries: sentence end, code fence, paragraph break
    const stableEnd = this.findStableBoundary(this.buffer)
    if (stableEnd > this.lastAnnounced.length) {
      const newText = this.buffer.slice(this.lastAnnounced.length, stableEnd)
      this.announcer.textContent = newText
      this.lastAnnounced = this.buffer.slice(0, stableEnd)
    }
  }

  private findStableBoundary(text: string): number {
    // Reuse same logic as IncrementalMarkdown
    // Sentence end: . ! ? followed by space + capital
    // Code fence: ```
    // Paragraph: \n\n
    const sentenceEnd = text.search(/[.!?]\s+[A-Z]/)
    const fenceEnd = text.lastIndexOf('```')
    const paraEnd = text.lastIndexOf('\n\n')
    return Math.max(sentenceEnd, fenceEnd, paraEnd) + 1
  }

  // Called when generation completes or stops
  complete() {
    if (this.announceTimer) clearTimeout(this.announceTimer)
    const remaining = this.buffer.slice(this.lastAnnounced.length)
    if (remaining.trim()) this.announcer.textContent = remaining
    this.announcer.textContent = 'Response complete'
    this.buffer = ''
    this.lastAnnounced = ''
  }

  error(message: string) {
    this.announcer.textContent = `Error: ${message}`
  }
}
```

