### 7. Semantic Cache (Phase 3) — *Engineering Spec*

**Architecture:** Embedding-based similarity → IndexedDB lookup → instant response for repeated/similar queries

```typescript
// cache/SemanticCache.ts
import { db } from '../db/schema'
import { openai } from '../providers/openai-client' // or any embedding provider

const SIMILARITY_THRESHOLD = 0.85
const MAX_CACHE_SIZE = 5000

export class SemanticCache {
  private memoryIndex: Map<string, Float32Array> = new Map()
  private initialized = false

  async init() {
    if (this.initialized) return
    const entries = await db.cache.toArray()
    for (const e of entries) this.memoryIndex.set(e.promptHash, e.embedding)
    this.initialized = true
  }

  // Generate embedding for prompt (uses cheap model)
  private async getEmbedding(text: string): Promise<Float32Array> {
    const response = await openai.embeddings.create({
      model: 'text-embedding-3-small',
      input: text.slice(0, 8000) // truncate
    })
    return new Float32Array(response.data[0].embedding)
  }

  // Normalize prompt for hashing
  private normalizePrompt(text: string): string {
    return text.toLowerCase().replace(/\s+/g, ' ').trim()
  }

  // Check cache before making API call
  async lookup(prompt: string): Promise<string | null> {
    await this.init()
    const normalized = this.normalizePrompt(prompt)
    const hash = await sha256(normalized)
    
    // Exact hit
    const exact = await db.cache.get({promptHash: hash})
    if (exact) {
      await db.cache.update(exact.id!, {hits: exact.hits + 1, updated: Date.now()})
      return exact.response
    }

    // Semantic search
    const embedding = await this.getEmbedding(normalized)
    const results = await db.semanticSearch(embedding, SIMILARITY_THRESHOLD, 3)
    
    if (results.length > 0) {
      const best = results[0]
      await db.cache.update(best.entry.id!, {hits: best.entry.hits + 1, updated: Date.now()})
      // Prepend cache notice
      return `[Cached • ${Math.round(best.score * 100)}% match]\n\n${best.entry.response}`
    }
    return null
  }

  // Store response after successful API call
  async store(prompt: string, response: string) {
    await this.init()
    const normalized = this.normalizePrompt(prompt)
    const hash = await sha256(normalized)
    const embedding = await this.getEmbedding(normalized)
    
    await db.cache.put({
      promptHash: hash,
      embedding,
      response,
      hits: 0,
      created: Date.now(),
      updated: Date.now()
    })
    this.memoryIndex.set(hash, embedding)
    
    // Eviction: keep only top MAX_CACHE_SIZE by hits + recency
    if (this.memoryIndex.size > MAX_CACHE_SIZE) {
      const entries = await db.cache.orderBy('updated').toArray()
      const toDelete = entries.slice(0, entries.length - MAX_CACHE_SIZE)
      await db.cache.bulkDelete(toDelete.map(e => e.id!))
      for (const e of toDelete) this.memoryIndex.delete(e.promptHash)
    }
  }
}

// SHA-256 helper (Web Crypto API)
async function sha256(text: string): Promise<string> {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text))
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('')
}
```

